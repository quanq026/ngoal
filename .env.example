# Shared .env for local development and Docker Compose deployment.
# Copy this file to .env (`cp .env.example .env`) and replace all secret values.

# ── Postgres ──
POSTGRES_USER=ngoal
POSTGRES_PASSWORD=ngoal
POSTGRES_DB=ngoal
POSTGRES_PORT=5432

# ── Database connection (api + drizzle migrations) ──
# Used locally; inside Docker Compose, api connects to postgres:5432 automatically.
DATABASE_URL=postgres://ngoal:ngoal@localhost:5432/ngoal

# ── Public origins ──
# API_URL — Public base URL of the Elysia API (auth, OAuth callbacks, email links).
# APP_URL — Public base URL of the Next.js web app (CORS, passkeys, redirects).
API_URL=http://localhost:3010
APP_URL=http://localhost:3001
# Optional public origin for inbound Git webhooks when API_URL is on a private network.
# GIT_WEBHOOK_BASE_URL=https://hooks.example.com

# ── Legal document URLs (optional, read by web at startup) ──
# PRIVACY_URL=https://example.com/privacy
# TERMS_URL=https://example.com/terms

# ── Auth & Security ──
# Generate a real random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-generate-a-real-secret
# 32-byte AES key used to encrypt stored GitHub OAuth / email provider credentials.
# Generate with: openssl rand -base64 32 (never rotate after saving credentials).
APP_ENCRYPTION_KEY=change-me-please-generate-a-real-key
# Passkey (WebAuthn) relying party settings.
# PASSKEY_RP_ID=ngoal.example.com
# PASSKEY_RP_NAME=nGoal
# COOKIE_DOMAIN=.example.com
# CLIENT_IP_HEADER=x-real-ip
# TRUSTED_PROXIES=10.0.0.5,172.18.0.0/16

# ── API Server ──
API_PORT=3010

# ── GitHub Integration (optional fallback; can also be configured in Team Settings -> Git) ──
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Pre-migration database backups ──
# BACKUP_RETENTION_DAYS=30
# BACKUP_DIR=/backups
# SKIP_PRE_MIGRATION_BACKUP=1

# ── S3 Object Store: RustFS (issue attachments) ──
# Leave S3_* unset to disable file uploads. Secret key must be >= 8 characters.
S3_ENDPOINT=http://localhost:9000      # Inside compose: http://minio:9000
S3_BUCKET=ngoal-attachments
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=false

# ── SSRF Allowlist (optional) ──
# Exact hostnames (comma-separated) allowed for outbound requests / webhooks.
# SSRF_ALLOWED_HOSTS=

# ── Outbound Email (optional; can also be configured in Team Settings -> Notification providers) ──
# EMAIL_FROM=nGoal <notifications@example.com>

# ── Web Frontend ──
WEB_PORT=3001

# ── Docker Images (used for GHCR / registry deployments) ──
# IMAGE_PREFIX=ghcr.io/your-org/ngoal
# VERSION=latest
